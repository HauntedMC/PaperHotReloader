<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.hauntedmc.platform</groupId>
        <artifactId>haunted-application-parent</artifactId>
        <version>2.0.0</version>
        <relativePath/>
    </parent>
    <groupId>nl.hauntedmc.paperhotreloader</groupId>
    <artifactId>paperhotreloader</artifactId>
    <version>${revision}</version>
    <name>PaperHotReloader</name>
    <description>Hot-load, unload, reload, and watch Paper plugins.</description>
    <url>https://github.com/HauntedMC/PaperHotReloader</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>HauntedMC</name>
        <url>https://www.hauntedmc.nl</url>
    </organization>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>HauntedMC</id>
            <name>HauntedMC</name>
            <url>https://www.hauntedmc.nl</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/HauntedMC/PaperHotReloader.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/HauntedMC/PaperHotReloader.git</developerConnection>
        <url>https://github.com/HauntedMC/PaperHotReloader</url>
        <tag>v1.0.5</tag>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/HauntedMC/PaperHotReloader/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/HauntedMC/PaperHotReloader/actions</url>
    </ciManagement>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - PaperHotReloader</name>
            <url>https://maven.pkg.github.com/HauntedMC/PaperHotReloader</url>
        </repository>
    </distributionManagement>
    <properties>
        <revision>1.0.5</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-09-25T00:00:00Z</project.build.outputTimestamp>
    </properties>
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>PaperHotReloader-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>platform-acceptance</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>acceptance-classpath</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>build-classpath</goal>
                                </goals>
                                <configuration>
                                    <includeScope>test</includeScope>
                                    <outputFile>${project.build.directory}/acceptance-classpath.txt</outputFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-platform-acceptance</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>src/acceptance/run-acceptance.sh</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <PHR_ARTIFACT>${project.build.directory}/${project.build.finalName}.jar</PHR_ARTIFACT>
                                        <PHR_PAPER_API_CLASSPATH>${project.build.directory}/acceptance-classpath.txt</PHR_PAPER_API_CLASSPATH>
                                        <PHR_RUNTIME_VERSION>${haunted.paper.runtime.version}</PHR_RUNTIME_VERSION>
                                        <PHR_RUNTIME_BUILD>${haunted.paper.runtime.build}</PHR_RUNTIME_BUILD>
                                        <PHR_RUNTIME_SHA256>${haunted.paper.runtime.sha256}</PHR_RUNTIME_SHA256>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
